# /etc/systemd/system/rpmgr-update.path
# SPDX-License-Identifier: Apache-2.0
# Written by `rpmgr systemd-unit update` (docs/10-operations.md, "Hardened systemd units"): starts
# the root-owned updater when the agent has staged a release, its manifest written last.
[Unit]
Description=rpmgr updater: a staged release
Documentation=https://github.com/felix-homelab/rpmgr

[Path]
PathChanged=/var/lib/rpmgr/update/manifest.json
Unit=rpmgr-update.service

[Install]
WantedBy=multi-user.target
# /etc/systemd/system/rpmgr-update.service
# SPDX-License-Identifier: Apache-2.0
# Written by `rpmgr systemd-unit update` (docs/10-operations.md, "Hardened systemd units"): the
# root-owned updater copies, verifies and installs the staged release, restarts the roles and rolls
# back when one is not ready (docs/04-security.md, "Over-the-air updates").
# It also runs once at boot, after the roles, so that an install a crash or reboot interrupted is
# finished: checked for readiness and rolled back if a role is not ready.
[Unit]
Description=rpmgr updater
Documentation=https://github.com/felix-homelab/rpmgr
After=network-online.target rpmgr-controller.service rpmgr-gateway.service rpmgr-connector.service rpmgr-all-in-one.service

[Service]
Type=oneshot
ExecStart={{.Bin}} updater apply --staged /var/lib/rpmgr/update --state /var/lib/rpmgr-update
# The status file stays after the run, so the agent reads it when it starts again.
RuntimeDirectory=rpmgr-update
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# It writes only the binary's directory, its own state, the status file, the drop-in directories
# of the roles' units, which the install scripts and rpmgr setup create, and the state directory of a
# controller or all-in-one, whose backup and restore it runs; one that is missing is skipped.
ProtectSystem=strict
ReadWritePaths={{.BinDir}} /var/lib/rpmgr-update -/var/lib/rpmgr -/etc/systemd/system/rpmgr-gateway.service.d -/etc/systemd/system/rpmgr-connector.service.d -/etc/systemd/system/rpmgr-all-in-one.service.d
# The staging directory, which the service user writes, stays read-only for the updater.
ReadOnlyPaths=-/var/lib/rpmgr/update
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
