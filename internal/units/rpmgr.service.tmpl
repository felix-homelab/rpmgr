# SPDX-License-Identifier: Apache-2.0
# rpmgr-{{.Role}}.service, written by `rpmgr systemd-unit {{.Role}}` (docs/10-operations.md,
# "Hardened systemd units").
[Unit]
Description=rpmgr {{.Role}}
Documentation=https://github.com/felix-homelab/rpmgr
After=network-online.target
Wants=network-online.target

[Service]
{{- if .Handoff}}
# Restarts with socket hand-off: the outcome of the last one. The notify type is in the drop-in
# handoff.conf (`rpmgr systemd-unit {{.Role}} --drop-in`), which a rollback to a release without
# the hand-off removes.
RuntimeDirectory=rpmgr/{{.Role}}
{{- end}}
User=rpmgr
Group=rpmgr
ExecStart={{.Bin}} {{.Role}} --config /etc/rpmgr/{{.Role}}.yaml
{{- if .ReloadHandoff}}
# systemctl reload restarts with a hand-off and fails, the old process serving, if the new one is
# not ready.
ExecReload={{.Bin}} handoff {{.Role}}
{{- else if .Reload}}
ExecReload=/bin/kill -HUP $MAINPID
{{- end}}
{{- if .BindLow}}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
{{- else}}
CapabilityBoundingSet=
{{- end}}
{{- if .Credential}}
LoadCredentialEncrypted={{.Credential}}:/etc/rpmgr/credstore/{{.Credential}}
{{- end}}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
StateDirectory=rpmgr
StateDirectoryMode=0750
ReadOnlyPaths=/etc/rpmgr
{{- if .Writable}}
# Directories the boot file names outside the state directory; "-" starts without a missing one.
{{- range .Writable}}
ReadWritePaths=-{{.}}
{{- end}}
{{- end}}
LimitNOFILE=1048576
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
