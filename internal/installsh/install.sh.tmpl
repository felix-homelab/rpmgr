#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# rpmgr {{.Version}} install script, served by the controller (docs/04-security.md, "Install
# scripts"). It installs a gateway or a connector from the controller's /dl/ mirror, after
# verifying the release with OpenSSL >= 3: root key (below) -> signing-key statement -> release
# manifest -> SHA-256 of the binary. The enrollment token never passes through this script:
# rpmgr enroll reads it from --token-file, from RPMGR_ENROLL_TOKEN, or from the terminal.
#
#   curl -fsSL <controller>/install.sh | sudo sh -s -- --controller <url> --ca-pin <pin> \
#     [--role gateway|connector] [--allow-target <target>]... [--token-file <file>] [--tcp-bbr]
#     [--verify-only]
set -eu

VERSION='{{.Version}}'
BIN=/usr/local/bin/rpmgr

die() { echo "rpmgr install: $*" >&2; exit 1; }
say() { echo "rpmgr install: $*" >&2; }

controller='' pin='' role=connector token_file='' bbr=0 verify_only=0 targets=''
nl='
'
while [ $# -gt 0 ]; do
  case $1 in
    --controller) [ $# -ge 2 ] || die "--controller needs a URL"; controller=$2; shift 2 ;;
    --ca-pin) [ $# -ge 2 ] || die "--ca-pin needs a pin"; pin=$2; shift 2 ;;
    --role) [ $# -ge 2 ] || die "--role needs gateway or connector"; role=$2; shift 2 ;;
    --allow-target) [ $# -ge 2 ] || die "--allow-target needs a target"
      case $2 in *"$nl"*) die "--allow-target with a newline" ;; esac
      targets="$targets$2
"; shift 2 ;;
    --token-file) [ $# -ge 2 ] || die "--token-file needs a file"; token_file=$2; shift 2 ;;
    --tcp-bbr) bbr=1; shift ;;
    --verify-only) verify_only=1; shift ;;
    *) die "unknown argument $1" ;;
  esac
done
case $controller in https://*) ;; *) die "--controller must be an https:// URL" ;; esac
controller=${controller%/}
[ -n "$pin" ] || [ "$verify_only" = 1 ] || die "--ca-pin is required (the controller's UI shows the command)"
case $role in gateway | connector) ;; *) die "--role must be gateway or connector" ;; esac
if [ "$role" = gateway ] && [ -n "$targets" ]; then die "a gateway has no local policy for --allow-target"; fi
if [ -n "$token_file" ] && [ ! -r "$token_file" ]; then die "cannot read --token-file $token_file"; fi

for tool in curl openssl sed grep date dd od wc head cut tr; do
  command -v "$tool" >/dev/null 2>&1 || die "$tool is needed"
done
v=$(openssl version 2>/dev/null) || die "openssl does not run"
case $v in
  "OpenSSL "[3-9].* | "OpenSSL "[1-9][0-9].*) ;;
  *) die "OpenSSL 3.0 or later is needed to verify the release; found: $v" ;;
esac
case $(uname -s)/$(uname -m) in
  Linux/x86_64) arch=amd64 ;;
  Linux/aarch64 | Linux/arm64) arch=arm64 ;;
  Linux/armv7l) arch=arm ;;
  Linux/riscv64) arch=riscv64 ;;
  *) die "no rpmgr build for $(uname -s)/$(uname -m)" ;;
esac

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
umask 077

# The release root keys of this controller's binary, by minisign key ID (bytes as in signatures).
{{range .Roots}}
cat >"$tmp/root-{{.ID}}.pem" <<'EOF'
{{.PEM}}EOF
{{- end}}

b64d() { tr -d '\n' | openssl base64 -d -A; }
hex() { od -An -v -tx1 | tr -d ' \n'; }
size() { wc -c <"$1" | tr -d ' '; }

# verify <signature file> <data file> <key prefix>: checks a minisign signature (prehashed, ED)
# with the key "<key prefix>-<key ID>.pem" its key ID names, and prints that key ID.
verify() {
  sigf=$1 data=$2 prefix=$3
  [ "$(wc -l <"$sigf" | tr -d ' ')" = 4 ] || die "$sigf is not a minisign signature file"
  case $(sed -n 1p "$sigf") in "untrusted comment: "*) ;; *) die "$sigf has no untrusted comment" ;; esac
  case $(sed -n 3p "$sigf") in "trusted comment: "*) ;; *) die "$sigf has no trusted comment" ;; esac
  sed -n 2p "$sigf" | b64d >"$tmp/sig" 2>/dev/null || die "$sigf is malformed"
  sed -n 4p "$sigf" | b64d >"$tmp/global" 2>/dev/null || die "$sigf is malformed"
  [ "$(size "$tmp/sig")" = 74 ] && [ "$(size "$tmp/global")" = 64 ] || die "$sigf is malformed"
  [ "$(head -c 2 "$tmp/sig")" = ED ] || die "$sigf is not a prehashed (ED) minisign signature"
  id=$(dd if="$tmp/sig" bs=1 skip=2 count=8 2>/dev/null | hex)
  key="$prefix-$id.pem"
  [ -f "$key" ] || die "$sigf is signed with an unknown key $id"
  dd if="$tmp/sig" bs=1 skip=10 count=64 of="$tmp/sig64" 2>/dev/null
  openssl dgst -blake2b512 -binary "$data" >"$tmp/hash"
  openssl pkeyutl -verify -pubin -inkey "$key" -rawin -in "$tmp/hash" -sigfile "$tmp/sig64" >/dev/null 2>&1 ||
    die "the signature of $(basename "$data") does not verify"
  { cat "$tmp/sig64"; sed -n 3p "$sigf" | sed 's/^trusted comment: //' | tr -d '\n'; } >"$tmp/trusted"
  openssl pkeyutl -verify -pubin -inkey "$key" -rawin -in "$tmp/trusted" -sigfile "$tmp/global" >/dev/null 2>&1 ||
    die "the trusted comment of $(basename "$data") does not verify"
  echo "$id"
}

# field <file> <key>: a JSON string field of a one-line document; refuses two or none.
field() {
  n=$(grep -o "\"$2\":\"[^\"]*\"" "$1" | wc -l | tr -d ' ')
  [ "$n" = 1 ] || die "$(basename "$1") has $n $2 fields"
  grep -o "\"$2\":\"[^\"]*\"" "$1" | sed "s/^\"$2\":\"//; s/\"\$//"
}

fetch() {
  curl -fsS --proto =https --tlsv1.2 --retry 2 --max-time 600 -o "$tmp/$1" "$controller/dl/$VERSION/$1" ||
    die "cannot download $1 from $controller/dl/$VERSION/"
}

say "downloading rpmgr $VERSION for linux/$arch from $controller"
artifact="rpmgr-$VERSION-linux-$arch"
for f in signing-key.json signing-key.json.minisig manifest.json manifest.json.minisig "$artifact"; do fetch "$f"; done

# 1. The statement, signed by a root key, names the signing key and is valid now.
verify "$tmp/signing-key.json.minisig" "$tmp/signing-key.json" "$tmp/root" >/dev/null
[ "$(grep -o '"statement":1[,}]' "$tmp/signing-key.json" | wc -l | tr -d ' ')" = 1 ] || die "the signing-key statement is not of format 1"
signer=$(field "$tmp/signing-key.json" signer)
now=$(date -u +%s)
nb=$(date -u -d "$(field "$tmp/signing-key.json" not_before)" +%s) || die "bad not_before"
na=$(date -u -d "$(field "$tmp/signing-key.json" not_after)" +%s) || die "bad not_after"
[ "$now" -ge "$nb" ] && [ "$now" -lt "$na" ] || die "the signing-key statement is not valid now"
[ $((na - nb)) -le $((366 * 86400)) ] || die "the signing-key statement is valid for more than 12 months"
printf %s "$signer" | b64d >"$tmp/signer" 2>/dev/null || die "the signing key is malformed"
[ "$(size "$tmp/signer")" = 42 ] && [ "$(head -c 2 "$tmp/signer")" = Ed ] || die "the signing key is not a minisign Ed25519 key"
sid=$(dd if="$tmp/signer" bs=1 skip=2 count=8 2>/dev/null | hex)
# An Ed25519 SubjectPublicKeyInfo: its 12-byte DER prefix, then the key.
{ printf '\060\052\060\005\006\003\053\145\160\003\041\000'; dd if="$tmp/signer" bs=1 skip=10 count=32 2>/dev/null; } >"$tmp/signer.der"
openssl pkey -pubin -inform DER -in "$tmp/signer.der" -out "$tmp/signing-$sid.pem" 2>/dev/null || die "the signing key is malformed"

# 2. The manifest, signed by that key, is of this version and lists the binary.
verify "$tmp/manifest.json.minisig" "$tmp/manifest.json" "$tmp/signing" >/dev/null
[ "$(field "$tmp/manifest.json" version)" = "$VERSION" ] || die "the manifest is not of version $VERSION"
seq=$(grep -o '"seq":[0-9]*' "$tmp/manifest.json" | cut -d: -f2)
[ -n "$seq" ] || die "the manifest has no seq"
entry=$(grep -o "{\"os\":\"linux\",\"arch\":\"$arch\",\"variant\":\"full\",\"sha256\":\"[0-9a-f]*\",\"size\":[0-9]*}" "$tmp/manifest.json") ||
  die "the manifest lists no full build for linux/$arch"
want_sum=$(echo "$entry" | sed 's/.*"sha256":"\([0-9a-f]*\)".*/\1/')
want_size=$(echo "$entry" | sed 's/.*"size":\([0-9]*\)}/\1/')

# 3. The binary has the manifest's size and SHA-256.
[ "$(size "$tmp/$artifact")" = "$want_size" ] || die "the binary's size does not match the manifest"
[ "$(openssl dgst -sha256 -r "$tmp/$artifact" | cut -d' ' -f1)" = "$want_sum" ] || die "the binary's SHA-256 does not match the manifest"
say "verified rpmgr $VERSION (manifest $seq)"
[ "$verify_only" = 0 ] || exit 0

[ "$(id -u)" = 0 ] || die "run as root (sudo sh -s -- ...)"
for tool in systemctl useradd install; do command -v "$tool" >/dev/null 2>&1 || die "$tool is needed"; done

id rpmgr >/dev/null 2>&1 || useradd --system --user-group --home-dir /var/lib/rpmgr --shell /usr/sbin/nologin rpmgr
install -d -m 0755 /etc/rpmgr
install -d -m 0750 -o rpmgr -g rpmgr /var/lib/rpmgr
install -d -m 0700 /var/lib/rpmgr-update
install -m 0755 "$tmp/$artifact" "$BIN.new"
mv -f "$BIN.new" "$BIN"

# The admin port of the role, or the next free one (docs/10-operations.md, "Ports").
case $role in gateway) port=7382 ;; connector) port=7383 ;; esac
# A port is taken when a TCP socket listens on it (state 0A), as /proc/net/tcp and tcp6 list it.
taken() {
  awk -v p=":$(printf %04X "$1")" '$4 == "0A" && substr($2, length($2) - 4) == p { found = 1 } END { exit !found }' \
    /proc/net/tcp /proc/net/tcp6 2>/dev/null
}
while taken "$port" || [ "$port" = 9090 ]; do port=$((port + 1)); done

boot=/etc/rpmgr/$role.yaml
if [ ! -f "$boot" ]; then
  {
    echo "version: 1"
    echo "controller:"
    echo "  endpoints: ['$controller']"
    echo "listen:"
    echo "  admin: '127.0.0.1:$port'"
  } >"$boot"
  chmod 0644 "$boot"
fi

if [ "$role" = connector ]; then
  policy=/etc/rpmgr/policy.yaml
  if [ ! -f "$policy" ]; then
    cat >"$policy" <<'EOF'
# Connector-local policy (docs/04-security.md, "Connector-local policy"). Edit with
# "rpmgr policy allow-target" and "rpmgr policy remove-target", or by hand as root.
version: 1
allow_targets: []
auto_update: auto
update_channel: stable
EOF
    chmod 0644 "$policy"
  fi
  printf %s "$targets" | while IFS= read -r t; do
    [ -n "$t" ] && "$BIN" policy allow-target --no-reload -- "$t"
  done
fi

# The updater's state, out of the service user's reach (docs/04-security.md, "Over-the-air
# updates"): how rpmgr was installed, and the floor and seq of the release it came from.
printf '{"method":"script","path":"%s","variant":"full","role":"%s"}\n' "$BIN" "$role" >/var/lib/rpmgr-update/install.json
printf '{"seq":%s,"floor":"%s"}\n' "$seq" "$VERSION" >/var/lib/rpmgr-update/state.json

# Host tuning (docs/03-connections.md, "Host tuning applied by the installer").
# The UDP buffers only rise, to the 7 MiB quic-go asks for; BBR only when asked. Minimal systems
# may not have /etc/sysctl.d yet.
install -d -m 0755 /etc/sysctl.d
{
  echo "# rpmgr: UDP buffers for QUIC"
  for k in net.core.rmem_max net.core.wmem_max; do
    cur=$(sysctl -n "$k" 2>/dev/null || echo 0)
    [ "$cur" -ge 7340032 ] 2>/dev/null || echo "$k = 7340032"
  done
  if [ "$bbr" = 1 ]; then echo "net.ipv4.tcp_congestion_control = bbr"; fi
} >/etc/sysctl.d/60-rpmgr.conf
sysctl -q -p /etc/sysctl.d/60-rpmgr.conf >/dev/null 2>&1 || say "could not apply /etc/sysctl.d/60-rpmgr.conf now; it applies at the next boot"

if [ -f /var/lib/rpmgr/identity/chain.pem ]; then
  say "this host is enrolled already; to enroll it again, run rpmgr enroll --replace"
else
  if [ -n "$token_file" ]; then
    "$BIN" enroll --controller "$controller" --ca-pin "$pin" --token-file "$token_file"
  else
    "$BIN" enroll --controller "$controller" --ca-pin "$pin"
  fi
  chown -R rpmgr:rpmgr /var/lib/rpmgr/identity
fi

install -d -m 0755 /etc/systemd/system
"$BIN" systemd-unit --bin "$BIN" "$role" >"/etc/systemd/system/rpmgr-$role.service"
systemctl daemon-reload
systemctl enable --now "rpmgr-$role"
say "rpmgr $VERSION runs as rpmgr-$role; admin listener 127.0.0.1:$port"
